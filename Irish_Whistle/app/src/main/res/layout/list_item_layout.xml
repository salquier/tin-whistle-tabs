<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <CheckBox
        android:id="@+id/mainActivity_favoriteToggle"
        android:layout_width="40dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:button="@android:drawable/btn_star"
        android:contentDescription="@string/favoriteToggle_description"
        android:focusable="false"
        android:gravity="center" />

    <TextView
        android:id="@+id/mainActivity_whistleKeyBadge"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentStart="true"
        android:background="@drawable/whistle_key_badge"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="D" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/mainActivity_whistleKeyBadge"
        android:layout_toStartOf="@id/mainActivity_favoriteToggle"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mainActivity_SheetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            tools:text="@string/mainActivity_sheetTitlePlaceholder" />

        <!-- Type and composer -->
        <TextView
            android:id="@+id/mainActivity_SheetSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#757575"
            android:textSize="13sp"
            tools:text="Reel · Trad." />
    </LinearLayout>
</RelativeLayout>
